				</outline>
			<outline text="examples/helloworld/config.json">
				<outline text="{">
					<outline text="&quot;watchFolder&quot;: &quot;/Volumes/MyBootDisk/Users/bullmancuso/publicFolder/&quot;,"/>
					<outline text="&quot;s3Folder&quot;: &quot;/bullmancuso.com/&quot;,"/>
					<outline text="&quot;urlS3Folder&quot;: &quot;http://bullmancuso.com/&quot;"/>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="lib/filesystem.js" isComment="true">
				<outline text="exports.deleteDirectory = fsDeleteDirectory;"/>
				<outline text="exports.sureFilePath = fsSureFilePath;"/>
				<outline text="exports.newObject = fsNewObject;"/>
				<outline text="exports.getObject = fsGetObject;"/>
				<outline text="exports.recursivelyVisitFiles = fsRecursivelyVisitFiles;"/>
				<outline text=""/>
				<outline text="var fs = require (&quot;fs&quot;);"/>

				</outline>
			</outline>
		<outline text="/publicfolder.io/code/testing/stream/">
			<outline text="uploadbigfile.js">
				<outline text="const myProductName = &quot;s3BigUpload&quot;, myVersion = &quot;0.4.1&quot;;   " created="Mon, 03 Feb 2014 03:21:03 GMT" pgfnum="36831"/>
				<outline text=""/>
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const AWS = require (&quot;aws-sdk&quot;);"/>
				<outline text="const s3 = new AWS.S3 ();"/>
				<outline text=""/>
				<outline text="const localFilePath = &quot;myBigFile.mp3&quot;, filetype = &quot;audio/mpeg&quot;, acl = &quot;public-read&quot;; //fill in your own values here"/>
				<outline text="const s3bucket = &quot;publicfolder.io&quot;, s3path = &quot;testing/myBigFile.mp3&quot;; //fill in your own values here"/>
				<outline text=""/>
				<outline text="function s3UploadBigFile (f, s3bucket, s3path, type, acl, callback) {">
					<outline text="let theStream = fs.createReadStream (f);"/>
					<outline text="let myParams = {">
						<outline text="Bucket: s3bucket,"/>
						<outline text="Key: s3path,"/>
						<outline text="ContentType: type, "/>
						<outline text="ACL: acl"/>
						<outline text="};"/>
						</outline>
					<outline text=""/>
					<outline text="let s3obj = new AWS.S3 ({params: myParams});"/>
					<outline text="s3obj.upload ({Body: theStream}, function (err, data) {">
						<outline text="if (callback !== undefined) {">
							<outline text="callback (err, data);"/>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="console.log (&quot;\n&quot; + myProductName + &quot; v&quot; + myVersion + &quot;.\n&quot;);"/>
				<outline text=""/>
				<outline text="s3UploadBigFile (localFilePath, s3bucket, s3path, filetype, acl, function (err, data) {">
					<outline text="if (err) {">
						<outline text="console.log (&quot;s3UploadBigFile returned err.message == &quot; + err.message);"/>
						<outline text="}"/>
						</outline>
					<outline text="else {">
						<outline text="console.log (&quot;s3UploadBigFile returned == &quot; + JSON.stringify (data, undefined, 4)); "/>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="package.json">
				<outline text="{">
					<outline text="&quot;name&quot;: &quot;s3BigUpload&quot;,"/>
					<outline text="&quot;description&quot;: &quot;Demo app for streamed uploads to S3 in Node.&quot;,"/>
					<outline text="&quot;author&quot;: &quot;Dave Winer &lt;dave@smallpicture.com&gt;&quot;,"/>
					<outline text="&quot;main&quot;: &quot;uploadbigfile.js&quot;,"/>
					<outline text="&quot;dependencies&quot; : {">
						<outline text="&quot;aws-sdk&quot;: &quot;*&quot;"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="readme.md">
				<outline text="# s3BigUpload">
					<outline text="S3 can handle streamed uploads, this example shows how, in Node/JavaScript."/>
					</outline>
				<outline text="### The story">
					<outline text="I'm working on an app that upstreams files from the user's desktop to a location on S3. "/>
					<outline text="I wondered if Amazon's API can do streamed uploads, and found that it can, but I couldn't get the &lt;a href=&quot;https://aws.amazon.com/blogs/developer/announcing-the-amazon-s3-managed-uploader-in-the-aws-sdk-for-javascript/&quot;&gt;example code&lt;/a&gt; to correctly upload files. I worked on it and this is the result. "/>
					<outline text="So, as I like to do, I prepared a &lt;i&gt;hello world&lt;/i&gt; type app that has been tested, and works, and is complete. "/>
					</outline>
				<outline text="### How to">
					<outline text="1. &lt;a href=&quot;https://github.com/scripting/s3BigUpload/archive/master.zip&quot;&gt;Download&lt;/a&gt; the folder, open it in your terminal app, cd into the folder."/>
					<outline text="2. Make sure your Amazon credentials are accessible, following the &lt;a href=&quot;http://docs.aws.amazon.com/sdk-for-javascript/v2/developer-guide/setting-credentials.html&quot;&gt;instructions&lt;/a&gt; on the AWS site. "/>
					<outline text="3. Change the values of localFilePath, filetype, acl, s3bucket and s3path to point to the file you want to upload and the location you want it uploaded to."/>
					<outline text="4. `node uploadbigfile.js`"/>
					</outline>
				<outline text="### Questions, comments">
					<outline text="Post an &lt;a href=&quot;https://github.com/scripting/s3BigUpload/issues&quot;&gt;issue&lt;/a&gt; here. I can't support S3, but if you spot a problem I want to know about it."/>
					<outline text="Dave Winer, September 2017"/>
					</outline>
				</outline>
			</outline>
		<outline text="/fargo.io/code/testing/chokidarhelloworld/">
			<outline text="hello.js">
				<outline text="var myVersion = &quot;0.4.1&quot;, myProductName = &quot;chokidarHelloWorld&quot;;   " created="Mon, 03 Feb 2014 03:21:03 GMT" pgfnum="36831"/>
				<outline text="const chokidar = require (&quot;chokidar&quot;);"/>
				<outline text="let watcher = chokidar.watch (&quot;watch/&quot;, {">
					<outline text="ignoreInitial: true,"/>
					<outline text="awaitWriteFinish: true"/>
					<outline text="});"/>
					</outline>
				<outline text="watcher.on (&quot;all&quot;, function (event, f) {">
					<outline text="console.log (&quot;event == &quot; + event + &quot;, f == &quot; + f);"/>
					<outline text="" isComment="true"/>
					<outline text="let stats = require (&quot;fs&quot;).statSync (f);" isComment="true"/>
					<outline text="console.log (JSON.stringify (stats, undefined, 4));" isComment="true"/>
					<outline text="" isComment="true"/>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="package.json">
				<outline text="{">
					<outline text="&quot;name&quot;: &quot;chokidarHelloWorld&quot;,"/>
					<outline text="&quot;description&quot;: &quot;Hello World for the chokidar package.&quot;,"/>
					<outline text="&quot;author&quot;: &quot;Dave Winer &lt;dave@smallpicture.com&gt;&quot;,"/>
					<outline text="&quot;main&quot;: &quot;hello.js&quot;,"/>
					<outline text="&quot;dependencies&quot; : {">
						<outline text="&quot;chokidar&quot;: &quot;*&quot;"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="readme.md">
				<outline text="# chokidar-hello-world">
					<outline text="A simple hello world app for &lt;a href=&quot;https://github.com/paulmillr/chokidar&quot;&gt;chokidar&lt;/a&gt;."/>
					</outline>
				<outline text="### How to">
					<outline text="To run the Hello World app:">
						<outline text="1. &lt;a href=&quot;https://github.com/scripting/chokidar-hello-world/archive/master.zip&quot;&gt;Download&lt;/a&gt; the folder from the repo. "/>
						<outline text="2. Unzip the folder. Create a sub-folder called &lt;i&gt;watch.&lt;/i&gt; "/>
						<outline text="2. Launch the Terminal app, `cd` to the app folder, type `npm install`."/>
						<outline text="3. Type `node hello.js` to run the app."/>
						<outline text="4. Copy a file into the &lt;i&gt;watch&lt;/i&gt; sub-folder. You should see a message saying &lt;i&gt;add&lt;/i&gt; followed by the path to the file that was added. Similarly if you delete a file you should see a message about that on the console. "/>
						<outline text="Note that when you add a file, you'll also get a &lt;i&gt;change&lt;/i&gt; event. And &lt;i&gt;delete&lt;/i&gt; is called &lt;i&gt;unlink&lt;/i&gt; in this context. "/>
						</outline>
					</outline>
				<outline text="### Why">
					<outline text="I was able to create some useful tools with chokidar, and I wanted to give back by making it easier for other people to get started with it. "/>
					</outline>
				<outline text="### Udates">
					<outline text="#### v0.4.1 -- 9/2/17 by DW">
						<outline text="Added new option,&lt;i&gt; awaitWriteFinish,&lt;/i&gt; with a value of true.  This setting matters when the user is copying large files into the watched folder. This way you only get the change event when the file has finished copying. &lt;a href=&quot;https://github.com/paulmillr/chokidar#performance&quot;&gt;Chokidar&lt;/a&gt; does this by polling to see if the file size changed, so this will make Chokidar slower. The other option is processing files before they're fully there."/>
						</outline>
					</outline>
				</outline>
			</outline>
		<outline text="publicfolder:">
			<outline text="index.html">
				<outline text="&lt;html&gt;">
					<outline text="&lt;head&gt;">
						<outline text="&lt;title&gt;PublicFolder&lt;/title&gt;"/>
						<outline text="&lt;meta http-equiv=&quot;Content-Type&quot; content=&quot;text/html; charset=utf-8&quot;&gt;"/>
						<outline text="&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;"/>
						<outline text="&lt;%basicIncludes2%&gt;"/>
						<outline text="&lt;!-- Facebook metadata --&gt;">
							<outline text="&lt;meta property=&quot;og:url&quot; content=&quot;http://publicfolder.io/&quot; /&gt;"/>
							<outline text="&lt;meta property=&quot;og:type&quot; content=&quot;website&quot; /&gt;"/>
							<outline text="&lt;meta property=&quot;og:title&quot; content=&quot;publicfolder.io&quot; /&gt;"/>
							<outline text="&lt;meta property=&quot;og:description&quot; content=&quot;Let's get your ideas off the desktop and into the cloud.&quot; /&gt;"/>
							<outline text="&lt;meta property=&quot;og:image&quot; content=&quot;http://publicfolder.io/images/escher.jpg&quot; /&gt;"/>
							<outline text="&lt;meta property=&quot;og:site_name&quot; content=&quot;nodestorage.io&quot; /&gt;"/>
							</outline>
						<outline text="&lt;!-- Twitter metadata --&gt;">
							<outline text="&lt;meta name=&quot;twitter:card&quot; content=&quot;summary_large_image&quot;&gt;"/>
							<outline text="&lt;meta name=&quot;twitter:site&quot; content=&quot;@davewiner&quot;&gt;"/>
